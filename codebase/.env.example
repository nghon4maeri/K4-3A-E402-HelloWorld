# ============================================================
#  FeedbackRadar — mẫu file cấu hình khoá API
# ============================================================
#
#  CÁCH DÙNG:
#    1. Copy file này thành  codebase/.env
#       (PowerShell:  Copy-Item codebase\.env.example codebase\.env)
#    2. Chọn provider và điền khoá tương ứng bên dưới
#    3. KHÔNG bao giờ commit file .env — nó đã nằm trong .gitignore
#
#  Lấy khoá Gemini MIỄN PHÍ tại:  https://aistudio.google.com/apikey
#  (bấm "Create API key", không cần thẻ tín dụng)
#
# ============================================================

# --- Provider dùng cho lần chạy hiện tại ---
# Chọn gemini hoặc deepseek. Nếu để trống, pipeline tự chọn provider có key.
AI_PROVIDER=gemini

# --- Gemini ---
# Dán key vào sau dấu = , không dấu nháy, không khoảng trắng
GEMINI_API_KEY=

# Model. gemini-3.6-flash nhanh và nằm trong hạn mức miễn phí.
# Nếu báo lỗi 429 (hết hạn mức), đổi sang: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=8192


# --- DeepSeek của đội ---
# Để dùng DeepSeek: đổi AI_PROVIDER=deepseek và điền key bên dưới.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com


# --- OpenAI (dự phòng, không bắt buộc) ---
# Không cần dùng các biến này cho Gemini hoặc DeepSeek.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
