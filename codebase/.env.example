# ============================================================
#  FeedbackRadar — mẫu file cấu hình khoá API
# ============================================================
#
#  CÁCH DÙNG:
#    1. Copy file này thành  codebase/.env
#       (Windows PowerShell:  Copy-Item codebase\.env.example codebase\.env)
#    2. Điền khoá thật vào dòng OPENAI_API_KEY bên dưới
#    3. KHÔNG bao giờ commit file .env — nó đã nằm trong .gitignore
#
#  Lấy khoá ở đâu:  https://platform.openai.com/api-keys
#
# ============================================================

# Khoá API OpenAI — dán vào sau dấu = , không có dấu nháy, không có khoảng trắng
OPENAI_API_KEY=

# Model dùng cho khâu gom cụm. gpt-4o-mini rẻ và đủ tốt cho hackathon.
# Đổi sang gpt-4o nếu muốn chất lượng cao hơn.
OPENAI_MODEL=gpt-4o-mini
